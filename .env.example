# Firebase Web SDK (Firebase Console > Project settings > Your apps > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server credentials used only by `npm run seed:firebase`.
# Preferred local option: absolute path to a downloaded service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional alternatives when Application Default Credentials are unavailable.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep literal \n sequences when putting a multiline key in an env file.
FIREBASE_PRIVATE_KEY=

